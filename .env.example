# คัดลอกเป็น .env แล้วแก้ค่าจริง
SECRET_KEY=dev-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
SITE_URL=http://127.0.0.1:8000

# DB: เว้น DB_HOST ว่าง = ใช้ SQLite (dev) / ตั้งค่า = ใช้ Postgres (prod)
DB_NAME=oxlet
DB_USER=oxlet
DB_PASSWORD=oxlet
DB_HOST=
DB_PORT=5432

# เก็บรูป/วิดีโอบน Cloudflare R2 (เว้นว่าง = เก็บในเครื่อง dev)
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_DOMAIN=

# Google Maps/Places API (ดึงรีวิวลูกค้า) — เปิด Places API + ใส่ Place ID ที่ Branch ใน admin
GOOGLE_MAPS_API_KEY=

# ติดต่อ/แจ้งเตือน (เฟสถัดไป)
LINE_CHANNEL_TOKEN=
LINE_GROUP_ID=
